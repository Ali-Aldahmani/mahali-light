# Git
.git
.gitignore
.gitattributes

# Secrets and local env — never bake into the image
.env
.env.*
!.env.example

# Dependencies and build artifacts
node_modules
server/node_modules
web/node_modules
web/.next
dist
release
build
out
coverage

# Tests and docs (keep docker/README out of the image)
tests
docs
*.md
!docker/README.md

# Runtime data
uploads
backups
tls
logs
tmp
temp
*.log
*.dump
*.sql.bak

# OS / IDE
.DS_Store
Thumbs.db
.idea
.vscode
.cursor

# Docker context noise
docker/postgres/backups/**
!docker/postgres/backups/.gitkeep
