# Server (required)
PORT=3000
NODE_ENV=production
# The store's business day. Decides which date/accounting period a sale,
# payment or attendance record lands in. IANA name; default Asia/Dubai.
STORE_TIMEZONE=Asia/Dubai
# Upstream proxies allowed to set X-Forwarded-For (IPs, CIDRs, hostnames or
# loopback/linklocal/uniquelocal). Docker sets this to the `nextjs` service;
# native installs default to loopback. Never list LAN ranges tills use.
# TRUSTED_PROXIES=loopback

# JWT — MUST be replaced with a cryptographically random value before deploying.
# Generate: node -e "require('crypto').randomBytes(48,(e,b)=>console.log(b.toString('hex')))"
JWT_SECRET=REPLACE_ME_WITH_OUTPUT_OF_node_-e_require_crypto_.randomBytes(48).toString(hex)
JWT_EXPIRES_IN=8h

# Backup encryption key (required in production). Encrypts NAS credentials and,
# when "Encrypt backup archives" is on, every backup archive. Store a copy OFF
# this server: without it encrypted backups cannot be restored. Decrypt an
# archive by hand with: node scripts/decryptBackup.js <file.tar.gz.enc> <out.tar.gz>
# Generate: node -e "require('crypto').randomBytes(32,(e,b)=>console.log(b.toString('hex')))"
MAHALI_BACKUP_SECRET=REPLACE_ME_WITH_OUTPUT_OF_node_-e_require_crypto_.randomBytes(32).toString(hex)

# PostgreSQL (required)
POSTGRES_DB=mahali_light
POSTGRES_USER=mahali
POSTGRES_PASSWORD=CHANGE_ME
PGHOST=localhost
PGPORT=5432
PGUSER=mahali
PGPASSWORD=CHANGE_ME
PGDATABASE=mahali_light
# Optional URL form (not used by the Node pool; PG* wins)
DATABASE_URL=postgresql://mahali:CHANGE_ME@localhost:5432/mahali_light

# Paths (host/dev). Docker overrides these with volumes.
UPLOADS_PATH=./uploads
BACKUPS_PATH=./backups
BCRYPT_ROUNDS=12

# CORS extra origins (optional). Loopback and SERVER_IP are allowed automatically.
# Example: http://pos.local
CORS_ORIGINS=

# LAN identity of the server PC (required for browser CORS / Socket.io from tills).
SERVER_IP=192.168.1.10
# Prefer false behind Docker HTTP on port 80. Set true only if you terminate TLS on Express.
SERVER_USE_HTTPS=false
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# Docker published ports
WEB_PORT=80
API_PORT=3000

# Development-only (Vite / Electron). Not required for Docker tills.
MAHALI_SERVER_IP=192.168.1.10
VITE_SERVER_IP=192.168.1.10
VITE_SERVER_PORT=3000

# Optional Hardware Agent on a till (not a Docker service)
NEXT_PUBLIC_HARDWARE_AGENT_URL=http://127.0.0.1:17473
NEXT_PUBLIC_EXPRESS_PORT=3000

# Optional future ML (docker compose --profile ml). Not required for POS.
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
LOG_LEVEL=info

# Global barcode lookup for "Add product" scan-to-autofill (optional).
# Default provider works out of the box on a free/rate-limited trial tier —
# no key needed to try it. Set an API key to move to a paid tier for higher
# volume, or set BARCODE_LOOKUP_PROVIDER=none to disable outbound lookups
# (scanning still works for barcodes already in this shop's own inventory).
BARCODE_LOOKUP_PROVIDER=upcitemdb
BARCODE_LOOKUP_API_KEY=
BARCODE_LOOKUP_API_URL=
