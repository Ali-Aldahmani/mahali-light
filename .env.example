# Server
PORT=3000
NODE_ENV=production

# JWT (min 64 chars in production)
JWT_SECRET=please-change-me-in-production-use-at-least-64-random-characters-here
JWT_EXPIRES_IN=8h

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahali_light
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mahali_light

# Paths
UPLOADS_PATH=./uploads
BACKUPS_PATH=./backups

# Bcrypt
BCRYPT_ROUNDS=12

# CORS — comma-separated browser origins allowed to call the API with credentials.
# The Electron renderer (file://) is always allowed implicitly.
# In dev add the Vite dev-server origin; in production this can be left empty
# because all PCs run the Electron app (not a web browser pointed at the server).
CORS_ORIGINS=http://localhost:5173

# Electron client (dev only — production uses appConfig.json)
MAHALI_SERVER_IP=192.168.1.10
VITE_SERVER_IP=192.168.1.10
VITE_SERVER_PORT=3000
