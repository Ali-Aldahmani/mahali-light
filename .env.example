# Server
PORT=3000
NODE_ENV=production

# JWT — MUST be replaced with a cryptographically random value before deploying.
# Generate one with:  node -e "require('crypto').randomBytes(48,(e,b)=>console.log(b.toString('hex')))"
# The server will refuse to start in production if it detects a known-weak placeholder value.
JWT_SECRET=REPLACE_ME_WITH_OUTPUT_OF_node_-e_require_crypto_.randomBytes(48).toString(hex)
JWT_EXPIRES_IN=8h

# Backup encryption key — used to AES-256-GCM encrypt NAS credentials stored in
# the database.  MUST be set before configuring a NAS backup destination.
# Generate one with:  node -e "require('crypto').randomBytes(32,(e,b)=>console.log(b.toString('hex')))"
# The server will refuse to start in production if this is not set.
MAHALI_BACKUP_SECRET=REPLACE_ME_WITH_OUTPUT_OF_node_-e_require_crypto_.randomBytes(32).toString(hex)

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahali_light
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mahali_light

# Paths
UPLOADS_PATH=./uploads
BACKUPS_PATH=./backups

# Bcrypt
BCRYPT_ROUNDS=12

# CORS — comma-separated browser origins allowed to call the API with credentials.
# The Electron renderer (file://) is always allowed implicitly.
# In dev add the Vite dev-server origin; in production this can be left empty
# because all PCs run the Electron app (not a web browser pointed at the server).
CORS_ORIGINS=http://localhost:5173

# ── HTTPS / TLS ───────────────────────────────────────────────────────────────
# Strongly recommended for LAN deployments — prevents JWT tokens and passwords
# from being transmitted in cleartext between the server PC and client PCs.
#
# Quick-start (recommended for most deployments):
#   1. Set SERVER_USE_HTTPS=true and SERVER_IP=<your server LAN IP> below.
#   2. Start the server once — it auto-generates a self-signed cert in <repo>/tls/
#      (requires openssl in PATH; Git-for-Windows includes it on Windows).
#   3. On each client PC open appConfig.json (in %APPDATA%\BytecraPOS) and set
#      "serverUseHttps": true  so Electron switches to https://.
#
# To use an externally managed certificate instead:
#   Set TLS_CERT_FILE and TLS_KEY_FILE to the absolute paths of your PEM files.
#   These take precedence over the auto-generated cert.
#
SERVER_USE_HTTPS=true
SERVER_IP=192.168.1.10
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# Electron client (dev only — production uses appConfig.json)
MAHALI_SERVER_IP=192.168.1.10
VITE_SERVER_IP=192.168.1.10
VITE_SERVER_PORT=3000
