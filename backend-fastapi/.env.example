# Same secrets as Express (.env at repo root). Do not commit real values.
JWT_SECRET=change-me-to-the-same-value-as-express
JWT_ALGORITHM=HS256

# PostgreSQL — same cluster Express uses. Do not create a second production DB.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mahali_light

# Optional explicit URL overrides PG* pieces.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mahali_light

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
LOG_LEVEL=info
