{
  "name": "mahali-light",
  "version": "1.1.0",
  "description": "Bytecra POS — Docker-first LAN point of sale for electrical retail (UAE). Native Next.js frontend, Express core API, PostgreSQL.",
  "author": {
    "name": "Ali Aldahmani",
    "email": "hello@bytecra.com"
  },
  "homepage": "https://bytecra.com",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "dev:server": "nodemon --watch server --watch shared server/index.js",
    "build:server": "node -e \"console.log('Server runs from source; no bundle step required.')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "server": "node server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop mahali-light",
    "pm2:restart": "pm2 restart mahali-light",
    "pm2:logs": "pm2 logs mahali-light",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drivelist": "^12.0.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "fast-csv": "^5.0.7",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pg": "^8.13.0",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "tar": "^7.5.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
