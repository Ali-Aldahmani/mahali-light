{
  "name": "mahali-light",
  "version": "1.0.0",
  "description": "Bytecra POS — Multi-PC Electron POS for electrical retail (UAE).",
  "main": "electron/main.js",
  "author": {
    "name": "Ali Aldahmani",
    "email": "hello@bytecra.com"
  },
  "homepage": "https://bytecra.com",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,server,electron -c blue,green,magenta \"vite\" \"nodemon --watch server --watch shared server/index.js\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:frontend": "vite",
    "dev:vite": "vite",
    "dev:server": "nodemon --watch server --watch shared server/index.js",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:server": "node -e \"console.log('Server runs from source; no bundle step required.')\"",
    "build:electron": "electron-builder --win --x64 --publish never",
    "build:electron:dir": "electron-builder --win --x64 --dir --publish never",
    "build:all": "npm run build && npm run build:electron",
    "lint": "eslint src electron shared --ext .js,.jsx",
    "lint:fix": "eslint src electron shared --ext .js,.jsx --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "server": "node server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop mahali-light",
    "pm2:restart": "pm2 restart mahali-light",
    "pm2:logs": "pm2 logs mahali-light",
    "pm2:status": "pm2 status"
  },
  "build": {
    "appId": "com.bytecra.pos",
    "productName": "Bytecra POS",
    "copyright": "Copyright © 2026 Bytecra. All rights reserved.",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,test,tests,__tests__}"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "BytecraPOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bytecra POS",
      "include": "assets/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ali-Aldahmani",
        "repo": "bytecra-pos"
      }
    ]
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drivelist": "^12.0.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "fast-csv": "^5.0.7",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.453.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pg": "^8.13.0",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.15.4",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "tar": "^7.5.15",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.47",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.1"
  }
}
